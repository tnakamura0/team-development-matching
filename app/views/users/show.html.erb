<% breadcrumb :mypage, @user %>

<div class="card p-6 sm:p-8">
  <div class="flex gap-3">
    <h1 class="page-title"><%= @user.name %></h1>
    <p class="mt-2 text-text-secondary"><%= @user.period %><%= t(".period") %></p>
  </div>
  <p class="mt-2 text-text-secondary"><%= @user.required_status_label %></p>
  <p class="mt-2 text-text-secondary"><%= @user.email_address %></p>
  <div class="mt-4">
    <%= link_to t(".profile_edit"), edit_user_path(@user), class: "btn-secondary" %>
  </div>
</div>
