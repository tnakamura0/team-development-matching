<div class="max-w-2xl mx-auto">
  <div class="form-card">
    <div class="flex items-baseline gap-3">
      <h1 class="font-bold text-3xl"><%= @user.name %></h1>
      <p class="mt-2 text-text-secondary"><%= @user.period %>期</p>
    </div>
    <p class="mt-2 text-text-secondary"><%= @user.required_status_label %></p>
    <% if authenticated? && @user == Current.user %>
      <p class="mt-2 text-text-secondary"><%= @user.email_address %></p>
      <div class="mt-4">
        <%= link_to "プロフィール編集", edit_user_path(@user), class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
