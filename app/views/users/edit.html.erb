<% breadcrumb :edit_profile, @user %>

<div class="form-card">
  <h1 class="page-title text-center"><%= t(".title") %></h1>

  <%= form_with model: @user, class: "mt-5 space-y-5 text-text-secondary" do |form| %>
    <% if form.object.errors.any? %>
      <div class="text-danger">
        Error: <%= form.object.errors.full_messages.first %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, required: true, class: "form-control" %>
    </div>

    <div>
      <%= form.label :period, class: "label" %>
      <%= form.number_field :period, required: true, min: 1, max: 1000, step: 1, class: "form-control" %>
    </div>

    <div>
      <%= form.label :required_status, class: "label" %>
      <%= form.select :required_status,
        Recruitment.required_statuses.keys.map { |key|
          [t("enums.recruitment.required_status.#{key}"), key]
        },
        {},
        class: "select" %>
    </div>

    <div>
      <%= form.submit t(".submit"), class: "w-full text-center btn-primary" %>
    </div>
  <% end %>
</div>
