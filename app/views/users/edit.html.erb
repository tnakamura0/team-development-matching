<div class="form-card">
  <h1 class="page-title text-center">プロフィール編集</h1>

  <%= form_with model: @user, class: "space-y-5 text-text-secondary" do |form| %>
    <% if form.object.errors.any? %>
      <div class="text-danger">
        Error: <%= form.object.errors.full_messages.first %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "ユーザー名", class: "label" %>
      <%= form.text_field :name, required: true, class: "form-control" %>
    </div>

    <div>
      <%= form.label :period, "期", class: "label" %>
      <%= form.number_field :period, required: true, min: 1, max: 1000, step: 1, class: "form-control" %>
    </div>

    <div>
      <%= form.label :required_status, "学習ステータス", class: "label" %>
      <%= form.select :required_status, User::REQUIRED_STATUS_LABELS.invert, {}, required: true, class: "select" %>
    </div>

    <div>
      <%= form.submit "更新する", class: "w-full text-center btn-primary" %>
    </div>

    <div class="text-center">
      <%= link_to "マイページに戻る", user_path(@user), class: "link" %>
    </div>
  <% end %>
</div>
