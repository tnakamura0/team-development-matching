<header class="fixed inset-x-0 top-0 z-50 bg-surface border-b border-border shadow-sm"
        data-controller="hamburger" data-action="keydown.esc@window->hamburger#close click@window->hamburger#closeOnClickOutside">
  <div class="max-w-6xl mx-auto px-8 h-16 flex items-center justify-between">
    <%= link_to "TeamUP!", root_path, class: "text-2xl font-bold text-primary hover:text-primary-hover" %>

    <% if authenticated? %>
      <%# PC用ナビ %>
      <nav class="hidden md:flex items-center gap-4 text-sm font-medium">
        <%= link_to t(".create_recruitment"), new_recruitment_path, class: "btn-primary" %>
        <%= link_to t(".mypage"), user_path(Current.user), class: "text-text-secondary hover:text-primary transition-colors" %>

        <%# TODO: #102 通知機能はMVP対象外のため非表示。実装時にif falseを外す %>
        <% if false %>
          <%= link_to "#", class: "p-2 rounded-full text-text-secondary hover:text-primary transition-colors", aria: { label: t(".notifications") } do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" >
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
          <% end %>
        <% end %>

        <%= button_to t(".logout"), session_path, method: :delete,
              class: "text-text-muted hover:text-text-secondary cursor-pointer transition-colors" %>
      </nav>

      <%# スマホ用: ＋ボタンとハンバーガーボタン %>
      <div class="flex items-center gap-1 md:hidden">
        <%= link_to new_recruitment_path, aria: { label: t(".create_recruitment") },
              class: "p-2 rounded-full text-primary hover:bg-primary-soft active:bg-primary-soft transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        <% end %>

        <button type="button" data-hamburger-target="button" data-action="hamburger#toggle" aria-label="<%= t(".menu") %>" aria-expanded="false" class="p-2 text-text-secondary hover:text-primary active:text-primary cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    <% else %>
      <nav class="flex items-center gap-2 sm:gap-4 text-sm font-medium">
        <%= link_to t(".login"), new_session_path, class: "btn-secondary px-2.5 py-1.5 sm:px-4 sm:py-2" %>
        <%= link_to t(".sign_up"), sign_up_path, class: "btn-primary px-2.5 py-1.5 sm:px-4 sm:py-2" %>
      </nav>
    <% end %>
  </div>

  <%# スマホ用メニュー（ヘッダーの下に伸びる） %>
  <% if authenticated? %>
    <div data-hamburger-target="menu" class="hidden md:hidden border-t border-border">
      <nav class="flex flex-col py-2 font-medium">
        <%= link_to user_path(Current.user), class: "flex items-center gap-3 px-8 py-3 text-text-secondary hover:bg-surface-hover active:bg-surface-hover" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          <%= t(".mypage") %>
        <% end %>

        <%# TODO: #102 通知機能はMVP対象外のため非表示。実装時にif falseを外す %>
        <% if false %>
          <%= link_to "#", class: "flex items-center gap-3 px-8 py-3 text-text-secondary hover:bg-surface-hover active:bg-surface-hover" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
            </svg>
            <%= t(".notifications") %>
          <% end %>
        <% end %>

        <hr class="my-2 border-border">

        <%= button_to session_path, method: :delete, form: { class: "w-full" },
              class: "w-full flex items-center gap-3 px-8 py-3 text-text-muted hover:bg-surface-hover active:bg-surface-hover cursor-pointer" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
          </svg>
          <%= t(".logout") %>
        <% end %>
      </nav>
    </div>
  <% end %>
</header>
