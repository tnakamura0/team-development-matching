<div class="form-card">
  <h1 class="page-title text-center"><%= t(".title") %></h1>

  <%= form_with model: @user, url: sign_up_path, class: "space-y-5 text-text-secondary" do |form| %>
    <% if form.object.errors.any? %>
      <div class=" text-danger">
        <%= form.object.errors.full_messages.first %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "form-control" %>
    </div>

    <div>
      <%= form.label :email_address, class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", class: "form-control" %>
    </div>

    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "form-control" %>
      <p class="mt-2 text-text-muted text-sm"><%= t(".password_hint") %></p>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-control" %>
    </div>

    <div>
      <%= form.submit t(".submit"), class: "w-full text-center btn-primary" %>
    </div>

    <div class="text-center">
      <span class="text-text-muted">
        <%= t(".login_message") %>
      </span>
      <%= link_to t(".login"), new_session_path, class: "link" %>
    </div>
  <% end %>
</div>
