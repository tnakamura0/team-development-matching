<% breadcrumb :edit_recruitment, @recruitment %>

<%= render "form", recruitment: @recruitment, submit_label: t(".submit") %>

<div class="my-6 lg:w-4/5 mx-auto">
  <%= link_to recruitment_path(@recruitment), class: "link inline-flex items-center gap-1" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    <span><%= t(".back_to_detail") %></span>
  <% end %>
</div>
