<div class="max-w-2xl mx-auto">
  <div class="p-6 border rounded-xl">
    <h1 class="font-bold text-3xl"><%= @recruitment.title %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= t(".author") %><%= @recruitment.user.name %></p>

    <div class="mt-4">
      <%= simple_format(@recruitment.body) %>
    </div>

    <div class="mt-4 pt-4 border-t">
      <p><%= t(".closing_date") %><%= @recruitment.closing_date %></p>
      <p><%= t(".positions_count") %><%= t(".people_count", count: @recruitment.positions_count) %></p>
      <p><%= t(".required_status") %><%= t("enums.recruitment.required_status.#{@recruitment.required_status}") %></p>
      <p><%= t(".application_status") %><%= @recruitment.accepting_applications ? t(".accepting") : t(".stopped") %></p>
    </div>

    <% if authenticated? && @recruitment.owned_by?(Current.user) %>
      <div class="mt-4 flex gap-2">
        <%= link_to t(".edit"), edit_recruitment_path(@recruitment), class: "px-4 py-2 border rounded-lg" %>
        <%= button_to t(".delete"), recruitment_path(@recruitment), method: :delete, form: { data: { turbo_confirm: t(".delete_confirm") } }, class: "px-4 py-2 border rounded-lg" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to t(".back_to_index"), recruitments_path %>
  </div>
</div>
