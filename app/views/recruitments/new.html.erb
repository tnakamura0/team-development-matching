<% if @recruitment.errors.any? %>
  <div class="text-red-600">
    <% @recruitment.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>

<%= form_with model: @recruitment do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :body %>
    <%= f.text_area :body %>
  </div>
  <div>
    <%= f.label :closing_date %>
    <%= f.date_field :closing_date %>
  </div>
  <div>
    <%= f.label :positions_count %>
    <%= f.number_field :positions_count %>
  </div>
  <div>
    <%= f.label :required_status %>
    <%= f.select :required_status, Recruitment.required_statuses.keys %>
  </div>
  <div>
    <%= f.submit "募集を作成" %>
  </div>
<% end %>
