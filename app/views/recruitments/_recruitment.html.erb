<div class="card hover:bg-surface-hover">
  <%= link_to recruitment, class: "block p-5" do %>
    <div class="flex justify-between">
      <%# 応募状態バッジ %>
      <% if recruitment.accepting_applications %>
        <p class="recruitment-open">
          募集中
        </p>
      <% else %>
        <p class="recruitment-close">
          募集終了
        </p>
      <% end %>

      <%# 募集基準 %>
      <div class="flex items-center justify-center gap-0.5">
        <p><%= I18n.t("enums.recruitment.required_status.#{recruitment.required_status}") %></p>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.99 7.5 3.75-3.75m0 0 3.75 3.75m-3.75-3.75v16.499H4.49" />
        </svg>
      </div>
    </div>

    <h2 class="mt-4 font-medium text-xl"><%= recruitment.title %></h2>
    <p class="mt-2 text-text-secondary flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
      </svg>
      <%= recruitment.user.name %>
    </p>

    <%# セパレーター %>
    <p class="mt-3 border-b border-border"></p>

    <div class="mt-3 flex justify-between">
      <div>
        <p class="text-text-secondary">募集締切日</p>
        <p><%= recruitment.closing_date %></p>
      </div>
      <div>
        <p class="text-text-secondary">募集人数</p>
        <p class="text-right">
          <span class="font-medium"><%= recruitment.positions_count %></span>名
        </p>
      </div>
    </div>
  <% end %>
</div>
